{
  "sourceLanguage": "en",
  "strings": {
    "A family can have up to 12 kids.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O familie poate avea cel mult 12 copii."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Familie kann bis zu 12 Kinder haben."
          }
        }
      }
    },
    "Apple or Google can't be reached right now. Try again later.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sau Google nu pot fi contactate acum. Încearcă mai târziu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple oder Google ist gerade nicht erreichbar. Versuche es später noch einmal."
          }
        }
      }
    },
    "Can't reach ZapaKid. Check your connection and try again.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ne putem conecta la ZapaKid. Verifică conexiunea și încearcă din nou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ZapaKid ist nicht erreichbar. Prüfe deine Verbindung und versuche es noch einmal."
          }
        }
      }
    },
    "Couldn't keep you signed in on this phone. Try again.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu te-am putut păstra conectat pe acest telefon. Încearcă din nou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten dich auf diesem Handy nicht angemeldet halten. Versuche es noch einmal."
          }
        }
      }
    },
    "Sign-in didn't work. Try again.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectarea nu a reușit. Încearcă din nou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung hat nicht geklappt. Versuche es noch einmal."
          }
        }
      }
    },
    "Sign-in took too long or was already used. Please sign in again.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectarea a durat prea mult sau a fost deja folosită. Conectează-te din nou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung hat zu lange gedauert oder wurde schon verwendet. Bitte melde dich erneut an."
          }
        }
      }
    },
    "Something went wrong. Try again.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceva n-a mers. Încearcă din nou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen. Versuche es noch einmal."
          }
        }
      }
    },
    "That isn't a ZapaKid invitation.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta nu e o invitație ZapaKid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine ZapaKid-Einladung."
          }
        }
      }
    },
    "That isn't a ZapaKid pairing code.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta nu e un cod de asociere ZapaKid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein ZapaKid-Kopplungscode."
          }
        }
      }
    },
    "This code expired or was already used. Ask for a new one.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Codul a expirat sau a fost deja folosit. Cere unul nou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist abgelaufen oder wurde schon benutzt. Bitte um einen neuen."
          }
        }
      }
    },
    "This copy of ZapaKid couldn't be verified. Install it from the App Store.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această copie ZapaKid nu a putut fi verificată. Instaleaz-o din App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese ZapaKid-Kopie konnte nicht überprüft werden. Installiere sie aus dem App Store."
          }
        }
      }
    },
    "Too many open codes. Use one or wait until it expires.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea multe coduri deschise. Folosește unul sau așteaptă să expire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele offene Codes. Nutze einen oder warte, bis er abläuft."
          }
        }
      }
    },
    "Too many sign-in attempts. Try again in %lld seconds.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Too many sign-in attempts. Try again in %lld second."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Too many sign-in attempts. Try again in %lld seconds."
                }
              }
            }
          }
        },
        "ro": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Prea multe încercări de conectare. Încearcă din nou peste %lld secundă."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Prea multe încercări de conectare. Încearcă din nou peste %lld secunde."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Prea multe încercări de conectare. Încearcă din nou peste %lld de secunde."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zu viele Anmeldeversuche. Versuche es in %lld Sekunde noch einmal."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zu viele Anmeldeversuche. Versuche es in %lld Sekunden noch einmal."
                }
              }
            }
          }
        }
      }
    },
    "Too many sign-in attempts. Try again in a few minutes.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea multe încercări de conectare. Încearcă din nou peste câteva minute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anmeldeversuche. Versuche es in ein paar Minuten noch einmal."
          }
        }
      }
    },
    "Use 1 to 40 letters for your name.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește între 1 și 40 de caractere pentru nume."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende 1 bis 40 Zeichen für deinen Namen."
          }
        }
      }
    },
    "You're already in a family with kids or another parent.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faci deja parte dintr-o familie cu copii sau cu alt părinte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist schon in einer Familie mit Kindern oder einem anderen Elternteil."
          }
        }
      }
    },
    "That code isn't a ZapaKid connection code.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta nu este un cod de conectare ZapaKid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein ZapaKid-Verbindungscode."
          }
        }
      }
    }
  },
  "version": "1.0"
}