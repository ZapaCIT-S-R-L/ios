    },
    "Done": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gata"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
