{
  "sourceLanguage": "en",
  "strings": {
    "%@ declined the call": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refuzat apelul"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat den Anruf abgelehnt"
          }
        }
      }
    },
    "%@ didn't answer": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu a răspuns"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat nicht geantwortet"
          }
        }
      }
    },
    "A call couldn't ring": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un apel nu a putut suna"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Anruf konnte nicht klingeln"
          }
        }
      }
    },
    "Accepts the parental agreement and continues to sign-in": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceptă acordul parental și continuă la conectare"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akzeptiert die Elternvereinbarung und geht weiter zur Anmeldung"
          }
        }
      }
    },
    "Add a kid": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un copil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kind hinzufügen"
          }
        }
      }
    },
    "Add your kids in Family first.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă mai întâi copiii în Familie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge zuerst deine Kinder unter Familie hinzu."
          }
        }
      }
    },
    "Apple didn't return a sign-in token.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple nu a trimis un token de conectare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat kein Anmelde-Token zurückgegeben."
          }
        }
      }
    },
    "Ask a parent to pair this phone again.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Roagă un părinte să asocieze din nou acest telefon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte deine Eltern, dieses Handy noch einmal zu koppeln."
          }
        }
      }
    },
    "Ask your parent to show the QR code in ZapaKid (Family, Pair phone).": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Roagă-ți părintele să-ți arate codul QR în ZapaKid (Familie, Asociază telefonul)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte deine Eltern, dir den QR-Code in ZapaKid zu zeigen (Familie, Handy koppeln)."
          }
        }
      }
    },
    "Call declined": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anruf abgelehnt"
          }
