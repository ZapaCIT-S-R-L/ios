{
  "sourceLanguage": "en",
  "strings": {
    "Accepts the parental agreement and continues to sign-in": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceptă acordul parental și continuă la conectare"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akzeptiert die Elternvereinbarung und geht weiter zur Anmeldung"
          }
        }
      }
    },
    "Add a kid": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un copil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kind hinzufügen"
          }
        }
      }
    },
    "Add your kids in Family first.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă mai întâi copiii în Familie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge zuerst deine Kinder unter Familie hinzu."
          }
        }
      }
    },
    "Apple didn't return a sign-in token.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple nu a trimis un token de conectare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat kein Anmelde-Token zurückgegeben."
          }
        }
      }
    },
    "Ask a parent to pair this phone again.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Roagă un părinte să asocieze din nou acest telefon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte deine Eltern, dieses Handy noch einmal zu koppeln."
          }
        }
      }
    },
    "Ask your parent to show the QR code in ZapaKid (Family, Pair phone).": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Roagă-ți părintele să-ți arate codul QR în ZapaKid (Familie, Asociază telefonul)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte deine Eltern, dir den QR-Code in ZapaKid zu zeigen (Familie, Handy koppeln)."
          }
        }
      }
    },
    "Call": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sună"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anrufen"
          }
        }
      }
    },
    "Calls": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apeluri"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anrufe"
          }
        }
      }
    },
    "Can't finish setting up secure chat on this phone yet. We'll keep trying.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu putem termina încă configurarea chatului securizat pe acest telefon. Mai încercăm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sichere Einrichtung des Chats auf diesem Handy ist noch nicht fertig. Wir versuchen es weiter."
          }
        }
      }
    },
    "Can't reach ZapaKid. Check your connection and try again.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ne putem conecta la ZapaKid. Verifică conexiunea și încearcă din nou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ZapaKid ist nicht erreichbar. Prüfe deine Verbindung und versuche es noch einmal."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulează"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "Chats": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaturi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats"
          }
        }
      }
    },
    "Chats with your family show up here.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaturile cu familia ta apar aici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats mit deiner Familie erscheinen hier."
          }
        }
