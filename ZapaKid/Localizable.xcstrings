    "Only a nickname. No real names, birthdays or photos.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar o poreclă. Fără nume reale, zile de naștere sau poze."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Spitzname. Keine echten Namen, Geburtstage oder Fotos."
          }
        }
      }
    },
    "Only adults can sign in as parents. Your phone shares only whether you are 18 or older.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar adulții se pot conecta ca părinți. Telefonul tău spune doar dacă ai 18 ani sau mai mult."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Erwachsene können sich als Eltern anmelden. Dein Handy teilt nur mit, ob du 18 oder älter bist."
          }
        }
      }
    },
    "Only parents can sign in": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar părinții se pot conecta"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Eltern können sich anmelden"
          }
        }
      }
    },
    "Open ZapaKid on your kid's phone, tap \"This is my kid's phone\" and scan this code.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide ZapaKid pe telefonul copilului, atinge „Acesta e telefonul copilului meu” și scanează codul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ZapaKid auf dem Handy deines Kindes, tippe auf „Das ist das Handy meines Kindes“ und scanne diesen Code."
          }
        }
      }
    },
    "Open ZapaKid on your other phone to share your keys with this one.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide ZapaKid pe celălalt telefon ca să-ți partajezi cheile cu acesta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ZapaKid auf deinem anderen Handy, um deine Schlüssel mit diesem zu teilen."
          }
        }
      }
    },
    "Or type the code": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau scrie codul"
