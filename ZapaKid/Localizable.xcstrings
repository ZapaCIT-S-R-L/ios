    },
    "End-to-end encrypted": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptat end-to-end"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende-zu-Ende-verschlüsselt"
