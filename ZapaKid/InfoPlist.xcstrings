{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "comment": "Microphone permission (calls, voice messages); kid-friendly.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZapaKid uses the microphone so you can talk with your family in calls and voice messages."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "ZapaKid folosește microfonul ca să poți vorbi cu familia ta în apeluri și mesaje vocale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ZapaKid nutzt das Mikrofon, damit du in Anrufen und Sprachnachrichten mit deiner Familie sprechen kannst."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Camera permission (scan the parent's pairing QR); kid-friendly.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZapaKid uses the camera only to scan your parent's QR code."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "ZapaKid folosește camera doar ca să scanezi codul QR al părintelui tău."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ZapaKid nutzt die Kamera nur, um den QR-Code deiner Eltern zu scannen."
          }
        }
      }
    }
  },
  "version": "1.0"
}